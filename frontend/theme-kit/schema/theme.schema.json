{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mouxue.local/theme-kit/theme.schema.json",
  "title": "主题包",
  "description": "一个主题包 = 三层令牌的值 + 一段可选的自定义 CSS 片段。令牌名就是 CSS 自定义属性名（含 -- 前缀），所以任何一处命名错误都会在下一次校验里被拒绝，而不是在界面上表现为某个地方颜色不对。",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "tokens"],
  "properties": {
    "$schema": {
      "type": "string",
      "description": "编辑器的自动补全提示用；校验器不读它。"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "description": "主题包标识。文件名必须与它一致（themes/<id>.json），否则 --theme <id> 会找不到它。"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "界面上给用户看的名字。"
    },
    "description": {
      "type": "string",
      "description": "一句话说明这个主题是什么味道/适合谁。"
    },
    "appearance": {
      "enum": ["light", "dark"],
      "description": "亮色还是暗色。系统偏好为暗色、而用户又没挑过主题时，套件按这个字段挑默认主题 —— 所以它必须如实写，不能因为「深色好看」就给一个亮色主题标 dark。"
    },
    "extends": {
      "type": "string",
      "description": "继承另一个主题包的缺省值（写它的 id）。写了 extends 就可以只声明要改的令牌 —— 不必把 14 个必填令牌抄一遍。不写 extends 时，14 个必填令牌**一个都不能少**。"
    },
    "tokens": {
      "type": "object",
      "additionalProperties": false,
      "description": "三层令牌的值。三层是给主题作者的心智模型：primitive 是物理颜料，semantic 是用途，component 是某个组件专有的槽位。编译后它们都在同一处 :root 上，因为 CSS 变量没有层。",
      "properties": {
        "primitive": { "$ref": "#/$defs/primitiveLayer" },
        "semantic": { "$ref": "#/$defs/semanticLayer" },
        "component": { "$ref": "#/$defs/componentLayer" }
      }
    },
    "css": {
      "type": "string",
      "maxLength": 20000,
      "description": "可选的自定义 CSS 片段，用于令牌表达不了的东西（图案、滤镜、动画）。它会被套件包进 @layer theme-extra { ... } ——你**不要**自己写 @layer。校验器会拒绝 @import / @layer / !important / </style / javascript: 等构造，但**不会**判断你写的选择器好不好看：这一段的正确性只有一部分是机器保证的，见 THEME_SPEC.md「自定义片段的边界」。"
    }
  },

  "$defs": {
    "requiredSemanticTokens": {
      "type": "array",
      "const": [
        "--bg-app", "--bg-surface", "--bg-inset",
        "--fg-primary", "--fg-secondary",
        "--accent", "--accent-hover", "--fg-on-accent",
        "--border-subtle", "--border-strong",
        "--state-ok", "--state-warn", "--state-danger",
        "--focus-ring"
      ],
      "description": "**必填清单的唯一出处。**校验器读这里，不另抄一份。语义是：一个主题包若不写 extends，就必须自己回答这 14 个问题 —— 它们正是「文字还看不看得清」所依赖的那一组。写了 extends 的变体包可以一个都不写。"
    },

    "tokenValue": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "description": "一个 CSS 值。可以是字面量（#f59e0b / 12px），也可以是对另一个令牌的引用（var(--p-orange-500)）—— 后者让「只改颜料」的主题不必把语义层抄一遍。",
      "pattern": "^[^;{}\\\\]+$"
    },

    "primitiveLayer": {
      "type": "object",
      "additionalProperties": false,
      "description": "第一层：物理颜料。与用途无关的值 —— 一个色号、一个圆角半径、一个间距。",
      "propertyNames": { "enum": [
        "--p-white",
        "--p-warm-50", "--p-warm-100", "--p-warm-200", "--p-warm-300",
        "--p-ink-100", "--p-ink-200", "--p-ink-300", "--p-ink-400", "--p-ink-500",
        "--p-ink-700", "--p-ink-800", "--p-ink-900",
        "--p-orange-400", "--p-orange-500", "--p-orange-600", "--p-orange-700",
        "--p-green-500", "--p-green-600",
        "--p-red-500", "--p-red-600",
        "--p-blue-500", "--p-blue-600",
        "--p-radius-xs", "--p-radius-sm", "--p-radius-md", "--p-radius-lg",
        "--p-radius-xl", "--p-radius-pill",
        "--p-space-1", "--p-space-2", "--p-space-3", "--p-space-4",
        "--p-space-5", "--p-space-6", "--p-space-7", "--p-space-8",
        "--p-text-xs", "--p-text-sm", "--p-text-base", "--p-text-lg",
        "--p-text-xl", "--p-text-2xl", "--p-text-3xl",
        "--p-leading-tight", "--p-leading-normal", "--p-leading-relaxed",
        "--p-font-sans", "--p-font-mono",
        "--p-shadow-sm", "--p-shadow-md", "--p-shadow-lg",
        "--p-duration-fast", "--p-duration-base", "--p-duration-slow",
        "--p-ease-out", "--p-ease-standard"
      ] },
      "patternProperties": { "^--p-": { "$ref": "#/$defs/tokenValue" } }
    },

    "semanticLayer": {
      "type": "object",
      "additionalProperties": false,
      "description": "第二层：用途。组件只读这一层与第三层。必填的 14 个是「可读性所依赖的那一组」—— 少一个，就不是一个完整的主题，而是一张贴纸。",
      "propertyNames": { "enum": [
        "--bg-app", "--bg-surface", "--bg-surface-2", "--bg-inset", "--bg-overlay",
        "--fg-primary", "--fg-secondary", "--fg-muted", "--fg-on-accent", "--fg-link",
        "--accent", "--accent-hover", "--accent-soft", "--accent-border",
        "--border-subtle", "--border-strong", "--border-accent",
        "--state-ok", "--state-ok-soft",
        "--state-warn", "--state-warn-soft",
        "--state-danger", "--state-danger-soft",
        "--state-info", "--state-info-soft",
        "--radius-control", "--radius-card", "--radius-panel", "--radius-chip",
        "--border-width", "--focus-ring-width", "--focus-ring-offset",
        "--space-gutter", "--space-section", "--space-inline", "--space-stack",
        "--font-ui", "--font-mono",
        "--text-body", "--text-caption", "--text-title", "--text-display",
        "--leading-body",
        "--shadow-card", "--shadow-pop", "--shadow-inset",
        "--duration-fast", "--duration-base", "--ease-out",
        "--focus-ring",
        "--layout-sidebar", "--layout-content-max", "--layout-chat",
        "--opacity-disabled"
      ] },
      "patternProperties": { "^--": { "$ref": "#/$defs/tokenValue" } }
    },

    "componentLayer": {
      "type": "object",
      "additionalProperties": false,
      "description": "第三层：组件专有槽位。只有「这个组件需要独立于语义层」时才在这里开一个令牌 —— 否则组件直接用第二层。两个 badge 令牌是硬要求：inferred 的东西必须在视觉上就能被认出来，不能靠用户去读文字。",
      "propertyNames": { "enum": [
        "--chat-bubble-user-bg", "--chat-bubble-user-fg",
        "--chat-bubble-assistant-bg", "--chat-bubble-assistant-fg",
        "--chat-note-fg", "--chat-thinking-bg",
        "--plan-step-bg", "--plan-step-current-bg", "--plan-step-current-border",
        "--plan-step-done-fg", "--plan-step-pending-fg",
        "--checkpoint-bg", "--checkpoint-border",
        "--stage-chip-bg", "--stage-chip-fg",
        "--trace-bg", "--trace-border", "--trace-ok-fg", "--trace-rejected-fg",
        "--pack-precedence-fg", "--pack-dropped-fg",
        "--shell-sidebar-bg", "--shell-topbar-bg", "--shell-divider",
        "--badge-inferred-bg", "--badge-inferred-fg",
        "--badge-stated-bg", "--badge-stated-fg"
      ] },
      "patternProperties": { "^--": { "$ref": "#/$defs/tokenValue" } }
    }
  }
}
