{
  "$schema": "../schema/theme.schema.json",
  "id": "midnight-ink",
  "name": "墨蓝夜读",
  "appearance": "dark",
  "description": "深色主题。演示两件 B 才做得到的事：只改颜料就带动整条语义链，以及用 css 片段加一层令牌表达不了的质感。",
  "extends": "base-warm",

  "tokens": {
    "primitive": {
      "--p-orange-400": "#f5c451",
      "--p-orange-500": "#e8a020",
      "--p-orange-600": "#cf8a12",
      "--p-orange-700": "#b8790a"
    },

    "semantic": {
      "--bg-app": "#14161c",
      "--bg-surface": "#1b1e26",
      "--bg-surface-2": "#22262f",
      "--bg-inset": "#101218",
      "--bg-overlay": "rgba(0, 0, 0, 0.55)",

      "--fg-primary": "#eceff4",
      "--fg-secondary": "#c2c8d4",
      "--fg-muted": "#8b93a3",
      "--fg-on-accent": "#1a1204",
      "--fg-link": "var(--p-orange-400)",

      "--accent": "var(--p-orange-500)",
      "--accent-hover": "var(--p-orange-400)",
      "--accent-soft": "#2a2519",
      "--accent-border": "var(--p-orange-600)",

      "--border-subtle": "#2c313c",
      "--border-strong": "#3d4453",

      "--state-ok": "#4ec98a",
      "--state-ok-soft": "#16281f",
      "--state-warn": "#e8b84b",
      "--state-warn-soft": "#2a2418",
      "--state-danger": "#f2777a",
      "--state-danger-soft": "#2c1a1c",
      "--state-info": "#6cabf5",
      "--state-info-soft": "#16202e",

      "--shadow-card": "0 1px 2px rgba(0, 0, 0, 0.4), 0 2px 10px rgba(0, 0, 0, 0.28)",
      "--shadow-pop": "0 12px 32px rgba(0, 0, 0, 0.55)",
      "--shadow-inset": "inset 0 1px 0 rgba(255, 255, 255, 0.04)",

      "--focus-ring": "var(--p-orange-400)"
    },

    "component": {
      "--chat-bubble-user-bg": "var(--p-orange-600)",
      "--chat-bubble-user-fg": "#1a1204",
      "--chat-bubble-assistant-bg": "#22262f",
      "--chat-bubble-assistant-fg": "#dfe4ec",
      "--chat-note-fg": "#8b93a3",
      "--chat-thinking-bg": "#101218",

      "--plan-step-bg": "#1b1e26",
      "--plan-step-current-bg": "#262a20",
      "--plan-step-done-fg": "#4ec98a",
      "--plan-step-pending-fg": "#8b93a3",

      "--checkpoint-bg": "#1a2130",
      "--checkpoint-border": "#2f3f58",

      "--stage-chip-bg": "#241f38",
      "--stage-chip-fg": "#b6a4f0",

      "--trace-bg": "#101218",
      "--trace-border": "#2c313c",
      "--trace-ok-fg": "#4ec98a",
      "--trace-rejected-fg": "#f2777a",

      "--pack-precedence-fg": "var(--p-orange-400)",
      "--pack-dropped-fg": "#6f7787",

      "--shell-sidebar-bg": "#101218",
      "--shell-topbar-bg": "#161920",
      "--shell-divider": "#262b34",

      "--badge-inferred-bg": "#2a2418",
      "--badge-inferred-fg": "#e8b84b",
      "--badge-stated-bg": "#16281f",
      "--badge-stated-fg": "#4ec98a"
    }
  },

  "css": "/* 令牌表达不了的质感：一层极淡的格线。\n   只挂在套件公开的钩子上（.tk-surface），不碰组件内部的东西 ——\n   组件内部没有稳定的类名可依赖，这条规矩让主题包不会随组件重构而碎掉。 */\n.tk-surface::before {\n  content: \"\";\n  position: absolute;\n  inset: 0;\n  pointer-events: none;\n  border-radius: inherit;\n  background-image:\n    repeating-linear-gradient(0deg, rgba(255, 255, 255, 0.028) 0 1px, transparent 1px 32px),\n    repeating-linear-gradient(90deg, rgba(255, 255, 255, 0.028) 0 1px, transparent 1px 32px);\n}\n\n/* 深色下链接的下划线太扎眼，换一种提示方式。 */\n.tk-surface a {\n  text-decoration-color: color-mix(in srgb, var(--accent) 45%, transparent);\n  text-underline-offset: 3px;\n}\n"
}
