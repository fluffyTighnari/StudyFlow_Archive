{
  "$schema": "../schema/theme.schema.json",
  "id": "base-warm",
  "name": "暖橙黄",
  "appearance": "light",
  "description": "默认主题：大块留白、圆角、暖橙黄点缀。长时间看不累，适合学习类界面。",

  "tokens": {
    "primitive": {
      "--p-white": "#ffffff",
      "--p-warm-50": "#fffbf5",
      "--p-warm-100": "#fff4e6",
      "--p-warm-200": "#ffe8cc",
      "--p-warm-300": "#ffd8a8",

      "--p-ink-100": "#f2ece6",
      "--p-ink-200": "#e6ddd4",
      "--p-ink-300": "#cbbfb4",
      "--p-ink-400": "#a1958c",
      "--p-ink-500": "#7a6f67",
      "--p-ink-700": "#4a423d",
      "--p-ink-800": "#2f2825",
      "--p-ink-900": "#1f1a17",

      "--p-orange-400": "#fb923c",
      "--p-orange-500": "#e8890c",
      "--p-orange-600": "#c26f05",
      "--p-orange-700": "#9a5603",

      "--p-green-500": "#128a45",
      "--p-green-600": "#0f6f38",
      "--p-red-500": "#c62a2a",
      "--p-red-600": "#a11f1f",
      "--p-blue-500": "#1f66d0",
      "--p-blue-600": "#17509f",

      "--p-radius-xs": "4px",
      "--p-radius-sm": "8px",
      "--p-radius-md": "12px",
      "--p-radius-lg": "16px",
      "--p-radius-xl": "24px",
      "--p-radius-pill": "999px",

      "--p-space-1": "4px",
      "--p-space-2": "8px",
      "--p-space-3": "12px",
      "--p-space-4": "16px",
      "--p-space-5": "20px",
      "--p-space-6": "24px",
      "--p-space-7": "32px",
      "--p-space-8": "48px",

      "--p-text-xs": "12px",
      "--p-text-sm": "13px",
      "--p-text-base": "15px",
      "--p-text-lg": "17px",
      "--p-text-xl": "20px",
      "--p-text-2xl": "26px",
      "--p-text-3xl": "34px",

      "--p-leading-tight": "1.35",
      "--p-leading-normal": "1.6",
      "--p-leading-relaxed": "1.85",

      "--p-font-sans": "system-ui, -apple-system, \"Segoe UI\", \"PingFang SC\", \"Microsoft YaHei\", sans-serif",
      "--p-font-mono": "ui-monospace, SFMono-Regular, Consolas, \"Liberation Mono\", monospace",

      "--p-shadow-sm": "0 1px 2px rgba(31, 26, 23, 0.06)",
      "--p-shadow-md": "0 2px 8px rgba(31, 26, 23, 0.07), 0 1px 2px rgba(31, 26, 23, 0.05)",
      "--p-shadow-lg": "0 12px 32px rgba(31, 26, 23, 0.12)",

      "--p-duration-fast": "120ms",
      "--p-duration-base": "200ms",
      "--p-duration-slow": "320ms",
      "--p-ease-out": "cubic-bezier(0.2, 0.8, 0.2, 1)",
      "--p-ease-standard": "cubic-bezier(0.4, 0, 0.2, 1)"
    },

    "semantic": {
      "--bg-app": "var(--p-warm-50)",
      "--bg-surface": "var(--p-white)",
      "--bg-surface-2": "var(--p-warm-100)",
      "--bg-inset": "var(--p-warm-200)",
      "--bg-overlay": "rgba(31, 26, 23, 0.32)",

      "--fg-primary": "var(--p-ink-900)",
      "--fg-secondary": "var(--p-ink-700)",
      "--fg-muted": "var(--p-ink-500)",
      "--fg-on-accent": "var(--p-ink-900)",
      "--fg-link": "var(--p-orange-700)",

      "--accent": "var(--p-orange-500)",
      "--accent-hover": "var(--p-orange-600)",
      "--accent-soft": "var(--p-warm-100)",
      "--accent-border": "var(--p-orange-400)",

      "--border-subtle": "var(--p-ink-200)",
      "--border-strong": "var(--p-ink-300)",
      "--border-accent": "var(--p-orange-500)",

      "--state-ok": "var(--p-green-600)",
      "--state-ok-soft": "#e7f6ec",
      "--state-warn": "#8a5a00",
      "--state-warn-soft": "#fdf3dc",
      "--state-danger": "var(--p-red-600)",
      "--state-danger-soft": "#fdecec",
      "--state-info": "var(--p-blue-600)",
      "--state-info-soft": "#e9f1fd",

      "--radius-control": "var(--p-radius-sm)",
      "--radius-card": "var(--p-radius-lg)",
      "--radius-panel": "var(--p-radius-xl)",
      "--radius-chip": "var(--p-radius-pill)",

      "--border-width": "1px",
      "--focus-ring-width": "2px",
      "--focus-ring-offset": "2px",

      "--space-gutter": "var(--p-space-5)",
      "--space-section": "var(--p-space-7)",
      "--space-inline": "var(--p-space-2)",
      "--space-stack": "var(--p-space-3)",

      "--font-ui": "var(--p-font-sans)",
      "--font-mono": "var(--p-font-mono)",
      "--text-body": "var(--p-text-base)",
      "--text-caption": "var(--p-text-xs)",
      "--text-title": "var(--p-text-xl)",
      "--text-display": "var(--p-text-2xl)",
      "--leading-body": "var(--p-leading-normal)",

      "--shadow-card": "var(--p-shadow-md)",
      "--shadow-pop": "var(--p-shadow-lg)",
      "--shadow-inset": "inset 0 1px 0 rgba(255, 255, 255, 0.6)",

      "--duration-fast": "var(--p-duration-fast)",
      "--duration-base": "var(--p-duration-base)",
      "--ease-out": "var(--p-ease-out)",

      "--focus-ring": "var(--p-orange-600)",
      "--focus-ring-width": "2px",

      "--layout-sidebar": "17rem",
      "--layout-content-max": "44rem",
      "--layout-chat": "26rem",

      "--opacity-disabled": "0.55"
    },

    "component": {
      "--chat-bubble-user-bg": "var(--p-orange-500)",
      "--chat-bubble-user-fg": "var(--p-ink-900)",
      "--chat-bubble-assistant-bg": "var(--p-white)",
      "--chat-bubble-assistant-fg": "var(--p-ink-800)",
      "--chat-note-fg": "var(--p-ink-500)",
      "--chat-thinking-bg": "var(--p-ink-100)",

      "--plan-step-bg": "var(--p-white)",
      "--plan-step-current-bg": "var(--p-warm-100)",
      "--plan-step-current-border": "var(--p-orange-500)",
      "--plan-step-done-fg": "var(--p-green-600)",
      "--plan-step-pending-fg": "var(--p-ink-500)",

      "--checkpoint-bg": "#f4f7fb",
      "--checkpoint-border": "#c9d8ec",

      "--stage-chip-bg": "#f1ecff",
      "--stage-chip-fg": "#5b3fb8",

      "--trace-bg": "var(--p-ink-100)",
      "--trace-border": "var(--p-ink-200)",
      "--trace-ok-fg": "var(--p-green-600)",
      "--trace-rejected-fg": "var(--p-red-600)",

      "--pack-precedence-fg": "var(--p-orange-700)",
      "--pack-dropped-fg": "var(--p-ink-400)",

      "--shell-sidebar-bg": "var(--p-warm-100)",
      "--shell-topbar-bg": "var(--p-white)",
      "--shell-divider": "var(--p-warm-200)",

      "--badge-inferred-bg": "#fdf3dc",
      "--badge-inferred-fg": "#7a4f00",
      "--badge-stated-bg": "#e7f6ec",
      "--badge-stated-fg": "#0f6f38"
    }
  }
}
