{
  "name": "@mouxue/theme-kit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "觅学之契 · 主题套件：三层令牌 + 可校验的主题包 + 受限自定义 CSS 层。零依赖。",
  "exports": {
    ".": "./src/index.mjs",
    "./packs": "./src/packs.mjs",
    "./base.css": "./src/base.css",
    "./schema": "./schema/theme.schema.json"
  },
  "scripts": {
    "validate": "node src/validate.mjs --all",
    "literals": "node tools/check-literals.mjs src",
    "test": "node --test",
    "check": "npm run validate && npm run literals && npm test"
  }
}
